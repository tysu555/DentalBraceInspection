<Window x:Class="DentalBraceInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
        xmlns:conv="clr-namespace:DentalBraceInspection.Converters"
        Title="牙套良率检测系统 — Dental Brace Yield Inspection"
        Width="1560" Height="920" MinWidth="1280" MinHeight="800"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <conv:LogLevelToBrushConverter x:Key="LogLevelBrush"/>
        <Style x:Key="ParamFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ParamFieldBox" TargetType="TextBox" BasedOn="{StaticResource ParamTextBox}"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================ 顶栏 ============================ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="6" CornerRadius="3" Background="{StaticResource BrushAccent}"
                            Margin="0,2,12,2"/>
                    <StackPanel>
                        <TextBlock Text="牙套良率检测系统" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Dental Brace Yield Inspection · Vision System" Style="{StaticResource FieldLabel}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EllStatus" Width="14" Height="14" Fill="{StaticResource BrushTextMuted}"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRunStatus" Text="已停止" Style="{StaticResource SectionTitle}"
                               Margin="8,0,24,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtClock" Text="--:--:--" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtDate" Text="" Style="{StaticResource FieldLabel}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ 主区域 ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Halcon 图像显示 ========== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,10" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushPanelAlt}"
                            CornerRadius="6,6,0,0" Padding="12,8">
                        <Grid>
                            <TextBlock Text="Halcon 图像显示" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtImageName" Text="未加载图像" Style="{StaticResource FieldLabel}"
                                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnOpenImage" Content="打开图像" Style="{StaticResource IndustrialButton}"
                                        Padding="10,4" Margin="0,0,8,0" Click="BtnOpenImage_Click"/>
                                <Button x:Name="BtnTriggerShot" Content="触发一次" Style="{StaticResource PrimaryButton}"
                                        Padding="10,4" Margin="0,0,8,0" Click="BtnTriggerShot_Click"/>
                                <Button x:Name="BtnFitWindow" Content="适应窗口" Style="{StaticResource IndustrialButton}"
                                        Padding="10,4" Click="BtnFitWindow_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <halcon:HSmartWindowControlWPF x:Name="HWindow" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- ========== 检测结果 + 设备控制 ========== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="检测结果" Style="{StaticResource SectionTitle}"/>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <!-- OK / NG -->
                        <Border x:Name="BrdVerdict" CornerRadius="8" Padding="12" Background="{StaticResource BrushPanelAlt}"
                                BorderThickness="2" BorderBrush="{StaticResource BrushBorder}">
                            <StackPanel>
                                <TextBlock x:Name="TxtVerdict" Text="--" FontSize="52" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock x:Name="TxtVerdictSub" Text="等待检测" FontSize="12"
                                           HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 数值 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="工件总数" Style="{StaticResource FieldLabel}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTotal" Text="0" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}" Margin="0,0,8,6"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="良品(有引脚)" Style="{StaticResource FieldLabel}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtGood" Text="0" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushGreen}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="缺引脚不良" Style="{StaticResource FieldLabel}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtNg" Text="0" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource BrushRed}" Margin="0,0,8,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="引脚总数" Style="{StaticResource FieldLabel}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="TxtPin" Text="0" FontSize="20" FontWeight="Bold"
                                       Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="本次良率" Style="{StaticResource FieldLabel}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtYield" Text="--" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource BrushGreen}" Margin="0,0,8,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="累计良率" Style="{StaticResource FieldLabel}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" x:Name="TxtYieldTotal" Text="--" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource BrushGreen}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="检测耗时" Style="{StaticResource FieldLabel}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtElapsed" Text="0 ms"
                                       FontSize="14" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="图像来源" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtSourceDesc" Text="-"
                                       FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource BrushTextMuted}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 设备控制 -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="设备控制" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button x:Name="BtnStart" Content="▶  启动" Style="{StaticResource SuccessButton}"
                                    Margin="0,0,4,0" Padding="10,14" FontSize="15" Click="BtnStart_Click"/>
                            <Button x:Name="BtnStop" Content="■  停止" Style="{StaticResource DangerButton}"
                                    Margin="4,0,0,0" Padding="10,14" FontSize="15" IsEnabled="False" Click="BtnStop_Click"/>
                        </UniformGrid>
                        <Button x:Name="BtnManual" Content="手动触发检测" Style="{StaticResource IndustrialButton}"
                                Margin="0,8,0,0" Padding="10,8" Click="BtnManual_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== 参数配置 / 历史数据 ========== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="4">
                <TabControl Style="{StaticResource IndustrialTabControl}">
                    <TabItem Header="参数配置" Style="{StaticResource IndustrialTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10,8">
                                <StackPanel x:Name="ConfigPanel" DataContext="{Binding}">
                                    <!-- 计数工位 -->
                                    <TextBlock Text="① 计数工位  (Number · 工件总数)" Style="{StaticResource SectionTitle}"/>
                                    <Border Style="{StaticResource Card}" Background="{StaticResource BrushPanelAlt}"
                                            Margin="0,8,0,14" Padding="10">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,8">
                                                <TextBlock Text="中值滤波半径" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding MedianRadius, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,8">
                                                <TextBlock Text="阈值上限 (max)" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding ThresholdMax, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,8">
                                                <TextBlock Text="闭运算宽" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding ClosingWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,8">
                                                <TextBlock Text="闭运算高" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding ClosingHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,8">
                                                <TextBlock Text="筛选面积下限" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding TotalAreaMin, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,8">
                                                <TextBlock Text="筛选面积上限" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding TotalAreaMax, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- 良品工位 -->
                                    <TextBlock Text="② 良品工位  (Number1 · 有引脚良品数)" Style="{StaticResource SectionTitle}"/>
                                    <Border Style="{StaticResource Card}" Background="{StaticResource BrushPanelAlt}"
                                            Margin="0,8,0,14" Padding="10">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,6,8">
                                                <TextBlock Text="预筛面积下限" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding GoodAreaMin, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,8">
                                                <TextBlock Text="预筛面积上限" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding GoodAreaMax, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,8">
                                                <TextBlock Text="宽度下限 / 上限" Style="{StaticResource ParamFieldLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Style="{StaticResource ParamFieldBox}" Text="{Binding MinWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="2" Style="{StaticResource ParamFieldBox}" Text="{Binding MaxWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,8">
                                                <TextBlock Text="高度下限 / 上限" Style="{StaticResource ParamFieldLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Style="{StaticResource ParamFieldBox}" Text="{Binding MinHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="2" Style="{StaticResource ParamFieldBox}" Text="{Binding MaxHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,8">
                                                <TextBlock Text="终筛面积下限" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding FinalAreaMin, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,8">
                                                <TextBlock Text="终筛面积上限" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding FinalAreaMax, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,8">
                                                <TextBlock Text="引脚开运算半径" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding OpeningRadius, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Margin="6,0,0,8">
                                                <TextBlock Text="引脚最大面积" Style="{StaticResource ParamFieldLabel}"/>
                                                <TextBox Style="{StaticResource ParamFieldBox}" Text="{Binding PinArea, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <!-- 运行 / 设备 -->
                                    <TextBlock Text="③ 运行 / 设备" Style="{StaticResource SectionTitle}"/>
                                    <Border Style="{StaticResource Card}" Background="{StaticResource BrushPanelAlt}"
                                            Margin="0,8,0,14" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="图像源模式" Style="{StaticResource ParamFieldLabel}"/>
                                            <ComboBox x:Name="CmbSourceMode" Style="{StaticResource ParamComboBox}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Folder (文件夹连续取图)"/>
                                                <ComboBoxItem Content="Single (单张图像)"/>
                                            </ComboBox>

                                            <TextBlock Text="图像文件夹" Style="{StaticResource ParamFieldLabel}"/>
                                            <TextBox Style="{StaticResource ParamFieldBox}" Margin="0,0,0,8"
                                                     Text="{Binding ImageFolder, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Text="单张图像路径" Style="{StaticResource ParamFieldLabel}"/>
                                            <TextBox Style="{StaticResource ParamFieldBox}" Margin="0,0,0,8"
                                                     Text="{Binding SingleImagePath, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Text="搜索通配符" Style="{StaticResource ParamFieldLabel}"/>
                                            <TextBox Style="{StaticResource ParamFieldBox}" Margin="0,0,0,8"
                                                     Text="{Binding SearchPattern, UpdateSourceTrigger=PropertyChanged}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="检测节拍 (ms)" Style="{StaticResource ParamFieldLabel}"/>
                                                    <TextBox Style="{StaticResource ParamFieldBox}"
                                                             Text="{Binding CycleDelayMs, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="允许 NG 数" Style="{StaticResource ParamFieldLabel}"/>
                                                    <TextBox Style="{StaticResource ParamFieldBox}"
                                                             Text="{Binding MaxNgAllowed, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox Content="连续运行模式" Style="{StaticResource ParamCheckBox}" Margin="0,10,0,0"
                                                      IsChecked="{Binding ContinuousMode, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="勾选=自动循环检测；取消=仅触发一次" Style="{StaticResource FieldLabel}" Margin="22,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1" Background="{StaticResource BrushPanelAlt}" CornerRadius="0,0,6,6" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="保存参数" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,4,6" Click="BtnSaveConfig_Click"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="加载参数" Style="{StaticResource IndustrialButton}"
                                            Margin="4,0,0,6" Click="BtnLoadConfig_Click"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="恢复默认" Style="{StaticResource IndustrialButton}"
                                            Margin="0,0,4,0" Click="BtnResetConfig_Click"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="应用并检测" Style="{StaticResource SuccessButton}"
                                            Margin="4,0,0,0" Click="BtnApplyConfig_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="历史数据" Style="{StaticResource IndustrialTabItem}">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="4,4,4,8">
                                <TextBlock Text="检测历史记录" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtSummary" Text="累计 0 · 良品 0 · 良率 0%" Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Button Content="导出 CSV" Style="{StaticResource IndustrialButton}" Padding="10,4"
                                            Margin="0,0,8,0" Click="BtnExportCsv_Click"/>
                                    <Button Content="清空" Style="{StaticResource IndustrialButton}" Padding="10,4"
                                            Click="BtnClearHistory_Click"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="HistoryGrid" Grid.Row="1" Style="{StaticResource IndustrialDataGrid}"
                                      ColumnHeaderStyle="{StaticResource ColHeader}" CellStyle="{StaticResource DataCell}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="90"/>
                                    <DataGridTextColumn Header="图像" Binding="{Binding ImageName}" Width="*"/>
                                    <DataGridTextColumn Header="总数" Binding="{Binding TotalCount}" Width="52"/>
                                    <DataGridTextColumn Header="良品" Binding="{Binding GoodCount}" Width="52"/>
                                    <DataGridTextColumn Header="不良" Binding="{Binding NgCount}" Width="52"/>
                                    <DataGridTextColumn Header="引脚" Binding="{Binding PinCount}" Width="52"/>
                                    <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedMs}" Width="60"/>
                                    <DataGridTemplateColumn Header="结果" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Result}" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushGreen}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Result}" Value="NG">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushRed}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ============================ 运行日志 ============================ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushPanelAlt}" CornerRadius="6,6,0,0" Padding="12,6">
                    <Grid>
                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="打开日志目录" Style="{StaticResource IndustrialButton}" Padding="10,4"
                                    Margin="0,0,8,0" Click="BtnOpenLogDir_Click"/>
                            <Button Content="清空日志" Style="{StaticResource IndustrialButton}" Padding="10,4"
                                    Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="LogList" Grid.Row="1" Style="{StaticResource LogListBox}"
                         ItemContainerStyle="{StaticResource LogListBoxItem}" Padding="8,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource BrushTextMuted}"
                                           FontFamily="Consolas" Width="70"/>
                                <TextBlock Text="{Binding LevelText}" Width="40" FontWeight="SemiBold"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"/>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============================ 状态栏 ============================ -->
        <Border Grid.Row="3" Background="{StaticResource BrushPanelAlt}" CornerRadius="4" Padding="12,5">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="EllHalcon" Width="10" Height="10" Fill="{StaticResource BrushAmber}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtHalconStatus" Text="HALCON 初始化中…" Style="{StaticResource FieldLabel}" Margin="6,0,24,0"/>
                    <TextBlock Text="●" Foreground="{StaticResource BrushBorder}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatusMsg" Text="系统就绪" Style="{StaticResource FieldLabel}"/>
                </StackPanel>
                <TextBlock Text="v1.0.0  ·  HALCON 24.11  ·  .NET Framework 4.8"
                           Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
